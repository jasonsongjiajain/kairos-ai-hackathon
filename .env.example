# Copy this file to .env for local development and replace these placeholders.
POSTGRES_DB=field_force_local
POSTGRES_USER=field_force_local
POSTGRES_PASSWORD=LOCAL_ONLY_INSECURE_CHANGE_ME
POSTGRES_PORT=5432
API_PORT=8000
# Compose API connects to the database using the service hostname.
DATABASE_URL=postgresql+psycopg://field_force_local:LOCAL_ONLY_INSECURE_CHANGE_ME@db:5432/field_force_local
# Use this URL when running the backend directly on the host.
HOST_DATABASE_URL=postgresql+psycopg://field_force_local:LOCAL_ONLY_INSECURE_CHANGE_ME@localhost:5432/field_force_local
JWT_SECRET=LOCAL_ONLY_INSECURE_REPLACE_WITH_RANDOM_VALUE
MODEL_API_KEY=LOCAL_ONLY_REPLACE_WITH_GIGX_API_KEY
MODEL_BASE_URL=https://gigx.nexa-dev.tm.com.my/llm/v1
MODEL_NAME=gigx/gemma-4-e2b-it
REASONING_MODEL_NAME=gigx/qwen3-vl-4b-instruct
EMBEDDING_MODEL=gigx/qwen3-embedding-0.6b
# Set providers to "hosted" to use the GIGX OpenAI-compatible API.
EMBEDDING_PROVIDER=hosted
MODEL_PROVIDER=hosted
REASONING_PROVIDER=hosted
# Initial schema is fixed at 1536; changing this requires a new migration.
EMBEDDING_DIMENSIONS=1536
# Chunks below this hybrid vector/lexical relevance score are withheld from chat answers.
RAG_MINIMUM_SCORE=0.0
DEMO_SEED_ENABLED=false
VITE_API_BASE_URL=http://localhost:8000
