# Copy this file to .env for local development and replace these placeholders.
POSTGRES_DB=field_force_local
POSTGRES_USER=field_force_local
POSTGRES_PASSWORD=LOCAL_ONLY_INSECURE_CHANGE_ME
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://field_force_local:LOCAL_ONLY_INSECURE_CHANGE_ME@localhost:5432/field_force_local
JWT_SECRET=LOCAL_ONLY_INSECURE_REPLACE_WITH_RANDOM_VALUE
MODEL_API_KEY=LOCAL_ONLY_NO_PROVIDER_KEY_CONFIGURED
MODEL_NAME=LOCAL_ONLY_SELECT_A_PROVIDER_MODEL
EMBEDDING_MODEL=LOCAL_ONLY_SELECT_A_PROVIDER_EMBEDDING_MODEL
VITE_API_BASE_URL=http://localhost:8000
